{
    "family": "yumpy-application",
    "containerDefinitions": [
        {
            "name": "yumpy-application",
            "image": "563748380420.dkr.ecr.us-east-2.amazonaws.com/yumpy-dog-app:8c71952217c2b68982be96a65753a6c0eec5737a",
            "cpu": 0,
            "memory": 2048,
            "portMappings": [
                {
                    "name": "yump-webapp-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "PG_DATABASE",
                    "value": "postgres"
                },
                {
                    "name": "PG_USER",
                    "value": "postgres"
                },
                {
                    "name": "PG_HOST",
                    "value": "database-1.c9s2wke08ucs.us-east-2.rds.amazonaws.com"
                }
            ],
            "secrets": [
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:563748380420:secret:yump-db-creds-vsLSsG"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/yump-app",
                    "awslogs-region": "us-east-2",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "executionRoleArn": "arn:aws:iam::563748380420:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}